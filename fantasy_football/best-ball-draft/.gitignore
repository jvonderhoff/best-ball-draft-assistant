ssl.key
ssl.crt
.dk_session.json
# Ephemeral runtime DB — shipping it in git shadowed the rankings seed/external
# store and reverted live edits on every deploy. Rankings now persist in the
# external DB (DATABASE_URL); this file is rebuilt locally on first run.
drafts.db

# V2 recommender projection cache (regenerated on demand)
app/data/projection_cache.json

# Local mirror of the payload pushed by the projections app. Rebuilt at boot from
# Postgres, so it never needs committing — and deliberately NOT committed: a
# committed payload file is precisely the shape that let a two-month-old rankings
# board serve silently as the live one (rankings_seed.json). Without it, a boot that
# cannot reach Postgres falls back to the local build and SAYS SO in
# /api/projections-v2's `source`, instead of serving a stale file that looks fine.
app/data/pushed_payload.json
# The news mirror, same story: a warm-read cache of what Postgres holds, rebuilt at
# boot by _hydrate_external_news. Committing it would ship one machine's snapshot of
# a feed as though it were part of the app.
app/data/pushed_news.json
tools/replay-draft.json

# Local backups taken before data refreshes
drafts.db.bak-*
app/data/player_cache.json.bak-*
tools/.field-cache/
